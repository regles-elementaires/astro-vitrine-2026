---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
import Idee from '../assets/actions/IDEE.png';

const ressources = (await getCollection('ressources')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title="Ressources - Règles Élémentaires" description="Accéder à des contenus fiables et utiles : Guides, études, outils pédagogiques, rapports, visuels. Nous mettons à disposition des ressources pour mieux comprendre les enjeux autour des règles et agir !" />
	</head>
	<body>
		<Header />
		<main>
			<div class="px-5 md:px-15 flex flex-wrap justify-center bg-rebeige-300 text-remaroon">
				<div class="md:w-6/12 pt-10 pb-0 md:py-20 flex items-center">
					<h1 class="text-left">Nos ressources</h1>
				</div>
				<div class="md:w-6/12 py-10 md:py-20 flex items-center justify-between">
					<p class="w-full md:w-1/2"><span class="font-bold">Accéder à des contenus fiables et utiles :</span><br/>Guides, études, outils pédagogiques, rapports, visuels : nous mettons à disposition des ressources pour mieux comprendre les enjeux autour des règles et agir !</p>
					<div class="hidden w-1/2 md:flex justify-center">
						<Image class="w-40" src={Idee} alt="" />
					</div>					
				</div>
			</div>
			<div class="px-5 md:px-15 flex flex-wrap justify-center text-remaroon">
				<div class="w-11/12 relative md:w-3/12 pt-10 pb-4 md:py-20">
					<form class="md:sticky md:top-[122px] bg-remaroon text-rebeige-300 rounded-xl md:m-2 p-6">
						<label class="font-bold" for="filter">Filtrer par thématique :</label>
						<select class="bg-rebeige-300 text-remaroon mt-4 p-2" name="filter">
							<option>Tout</option>
							<option>Composition</option>
							<option>Éducation menstruelle</option>
							<option>Europe</option>
							<option>Inclusivité</option>
							<option>Ménopause</option>
							<option>Précarité menstruelle</option>
							<option>Santé menstruelle</option>
							<option>Sport</option>
						</select>
					</form>
				</div>
				<div class="w-11/12 md:w-9/12 md:ps-10 pt-0 md:pt-20 flex flex-col flex-wrap">
					<form class="w-full flex flex-wrap mb-10">
						<div class="w-full md:w-1/3 mt-2 md:pe-4">
							<input type="checkbox" id="guides-checkbox" name="type" value="guides" class="hidden checkboxes" checked>
							<label for="guides-checkbox" class="h-full flex items-center justify-center bg-reyellow gouttes-ressources p-10 rounded-3xl text-center font-lorimer-condensed text-3xl">Guides pratiques</label>
						</div>	
						<div class="w-full md:w-1/3 mt-2 md:px-4">
							<input type="checkbox" id="affiches-checkbox" name="type" value="affiches" class="hidden checkboxes" checked>
							<label for="affiches-checkbox" class="h-full flex items-center justify-center bg-reorange gouttes-ressources p-10 rounded-3xl text-center font-lorimer-condensed text-3xl">Affiches & brochures</label>
						</div>
						<div class="w-full md:w-1/3 mt-2 md:ps-4">
							<input type="checkbox" id="enquetes-checkbox" name="type" value="enquetes" class="hidden checkboxes" checked>
							<label for="enquetes-checkbox" class="h-full flex items-center justify-center bg-redarkpink gouttes-ressources p-10 rounded-3xl text-center font-lorimer-condensed text-3xl">Enquêtes & études</label>
						</div>					
					</form>
					<div id="guides" class="anchor">
						<h2>Guides pratiques</h2>					
						<div class="py-10 flex flex-wrap items-stretch">
							{
								ressources.filter((ressource) => (ressource.data.type == "Guide pratique") ).map((ressource) => ( 
									<div class="ressource w-full md:w-1/3 py-2 md:px-2" data-tags={ressource.data.themes}>
										<div class="bg-rebeige-500 rounded-xl h-full transition-all duration-300">
											<Image class="w-full rounded-t-xl" src={ressource.data.image} alt="" />
											<p class="px-4 text-rered mt-4 font-lorimer-condensed-black text-3xl">{ressource.data.title}</p> 
											<p class="mx-4 mt-2 inline-block bg-remaroon text-rebeige-300 font-lorimer-condensed px-1.5 py-0.5 text-2xl">{ressource.data.type}</p>
											<p class="px-4 mt-2">{ressource.data.description}</p>
											<a class="px-4 mt-3 pb-6 inline-block underline font-semibold" href={ressource.data.link} target="_blank">Consulter la ressource</a>
										</div>
									</div> 
								))
							}
						</div>
					</div>		
					<div id="affiches" class="anchor">
						<h2>Affiches & brochures</h2>					
						<div class="py-10 flex flex-wrap items-stretch">
							{
								ressources.filter((ressource) => (ressource.data.type == "Affiche" || ressource.data.type == "Brochure") ).map((ressource) => ( 
									<div class="ressource w-full md:w-1/3 py-2 md:px-2" data-tags={ressource.data.themes}>
										<div class="bg-rebeige-500 rounded-xl h-full transition-all duration-300">
											<Image class="w-full rounded-t-xl" src={ressource.data.image} alt="" />
											<p class="px-4 text-rered mt-4 font-lorimer-condensed-black text-3xl">{ressource.data.title}</p> 
											<p class="mx-4 mt-2 inline-block bg-remaroon text-rebeige-300 font-lorimer-condensed px-1.5 py-0.5 text-2xl">{ressource.data.type}</p>
											<p class="px-4 mt-2">{ressource.data.description}</p>
											<a class="px-4 mt-3 pb-6 inline-block underline font-semibold" href={ressource.data.link} target="_blank">Consulter la ressource</a>
										</div>
									</div> 
								))
							}
						</div>
					</div>			
					<div id="enquetes" class="anchor">
						<h2>Enquêtes & études</h2>					
						<div class="py-10 flex flex-wrap items-stretch">
							{
								ressources.filter((ressource) => (ressource.data.type == "Enquête" || ressource.data.type == "Étude") ).map((ressource) => ( 
									<div class="ressource w-full md:w-1/3 py-2 md:px-2" data-tags={ressource.data.themes}>
										<div class="bg-rebeige-500 rounded-xl h-full transition-all duration-300">
											<Image class="w-full rounded-t-xl" src={ressource.data.image} alt="" />
											<p class="px-4 text-rered mt-4 font-lorimer-condensed-black text-3xl">{ressource.data.title}</p> 
											<p class="mx-4 mt-2 inline-block bg-remaroon text-rebeige-300 font-lorimer-condensed px-1.5 py-0.5 text-2xl">{ressource.data.type}</p>
											<p class="px-4 mt-2">{ressource.data.description}</p>
											<a class="px-4 mt-3 pb-6 inline-block underline font-semibold" href={ressource.data.link} target="_blank">Consulter la ressource</a>
										</div>
									</div> 
								))
							}
						</div>
					</div>
				</div>				
			</div>
		</main>
		<Footer />
		<script>
			function findLabel(inputElement) {
				const inputId = inputElement.id;
				// Get the input's ID
				const label = document.querySelector(`label[for="${inputId}"]`);
				// Find label with matching 'for' attribute
				return label;
			}

			function sortList() {

				// THEMATIQUES
				let items = document.querySelectorAll(".ressource");
				// Get the filter select input and add listener for the change event
				let select = document.querySelector("select");
				select.addEventListener("change", sort);

				// Actually sorting the cards
				function sort() {
					// Look at each item in the array
					items.forEach(element => {
						// Remove the "hidden" attribute if the item has the tag selected or if the selection is "All"
						// Otherwise, add the hidden attribute to the element
						if (element.dataset.tags.includes(select.value) | select.value == "Tout") {
						element.removeAttribute("hidden");
						} else { element.setAttribute("hidden", true); }
					});
				};

				// TYPES
				let guides = document.querySelector('#guides');
				let affiches = document.querySelector('#affiches');
				let enquetes = document.querySelector('#enquetes');
				let checkboxes = document.querySelectorAll(".checkboxes");

				checkboxes.forEach(element => {
					element.addEventListener("change", function(e) {
						console.log(e.target.checked);
						e.target.checked ? findLabel(element).classList.remove("opacity-50") : findLabel(element).classList.add("opacity-50");
						if (e.target.value == "guides") {
							e.target.checked ? guides.removeAttribute("hidden") : guides.setAttribute("hidden", true);
						}
						if (e.target.value == "affiches") {
							e.target.checked ? affiches.removeAttribute("hidden") : affiches.setAttribute("hidden", true);
						}
						if (e.target.value == "enquetes") {
							e.target.checked ? enquetes.removeAttribute("hidden") : enquetes.setAttribute("hidden", true);
						}
					})
				});

				// perform the sort funtion on initialization to cover edge cases, such as the user refreshing the page
				sort();
			}

			sortList();
			
		</script>
	</body>
</html>
