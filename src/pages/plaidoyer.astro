</Base>

<script>
    /* https://tailwindflex.com/@Starboy/our-services */

    document.addEventListener('DOMContentLoaded', () => {
        const track = document.getElementById('track-actions');
        const nextBtn = document.getElementById('nextBtn-actions');
        const prevBtn = document.getElementById('prevBtn-actions');
        const dotsContainer = document.getElementById('indicators');
        
        let index = 0;
        const items = track!.children;
        const itemsPerView = window.innerWidth >= 768 ? 3 : 1;
        const maxIndex = items.length - itemsPerView;

        // Generar Puntos
        for (let i = 0; i <= maxIndex; i++) {
            const dot = document.createElement('button');
            dot.className = `h-3 rounded-full transition-all duration-300 ${i === 0 ? 'bg-rered w-8' : 'bg-rebeige-100 w-3'}`;
            dot.addEventListener('click', () => { index = i; updateCarousel(); });
            dotsContainer!.appendChild(dot);
        }
        const dots = dotsContainer!.children;


        function updateCarousel() {
            track!.style.transform = `translateX(-${(index * 100) / itemsPerView}%)`;
            Array.from(dots).forEach((dot, i) => {
                dot.className = `h-3 rounded-full transition-all duration-300 ${i === index ? 'bg-rered w-8' : 'bg-rebeige-100 w-3'}`;
            });
        }

        function nextSlide() {
            index = index < maxIndex ? index + 1 : 0;
            updateCarousel();
        }
        
        function prevSlide() {
            index = index > 0 ? index - 1 : maxIndex;
            updateCarousel();
        }

        nextBtn!.addEventListener('click', () => { nextSlide(); });
        prevBtn!.addEventListener('click', () => { prevSlide(); });
        
    });
</script>